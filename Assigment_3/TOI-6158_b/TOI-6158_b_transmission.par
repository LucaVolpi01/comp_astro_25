[Global]
xsec_path = /ca25/comp_astro_25/src/daneel/parameters/xsecs/
cia_path = /ca25/comp_astro_25/src/daneel/parameters/cia/hitran/
mpi_use_shared = True

[Observation]
observation_type = text
observed_spectrum = ./outputs/TOI-6158_b_observed_spectrum.dat

[Chemistry]
chemistry_type = taurex
fill_gases = H2,He
ratio = 0.25

[[H2O]]
gas_type = constant
mix_ratio=4.72e-3

[[CH4]]
gas_type = constant
mix_ratio=8.11e-6

[[CO2]]
gas_type = constant
mix_ratio=2.39e-4

[[CO]]
gas_type = constant
mix_ratio=7.56e-4


[Temperature]
profile_type = isothermal
T = 636

[Pressure]
profile_type = Simple
atm_min_pressure = 1e-4
atm_max_pressure = 1e6
nlayers = 100

[Planet]
planet_type = Simple
planet_mass = 0.425
planet_radius = 0.93

[Star]
star_type = blackbody
temperature = 3467

[Model]
model_type = transmission

    [[Absorption]]

    [[CIA]]
    cia_pairs = H2-H2, H2-He

    [[Rayleigh]]

[Optimizer]
optimizer = nestle
num_live_points = 80
method = single
tol = 1000

[Output]
output_dir = /ca25/comp_astro_25/Assigment_3/outputs
spectrum_output = TOI-6158_b_assignment3_taskA_spectrum.dat

[Fitting]
planet_radius:fit =True
planet_radius:bounds = 0.5, 1.5

T:fit =True
T:bounds = 300, 1000

H2O:fit = True
H2O:bounds = 1e-10, 1e-2
